        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "eslint": "^9",
        "eslint-config-next": "16.4.6",
        "husky": "^9.1.7",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "lint-staged": "^17.6.1",
        "msw": "^3.0.6",
        "prettier": "^3.10.1",
        "tailwindcss": "4.3.3",
        "ts-jest": "^29.4.15",
        "typescript": "^5"
    },
    "msw": {
        "workerDirectory": [
            "public"
